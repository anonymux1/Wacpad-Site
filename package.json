{
  "name": "wacpad-site",
  "version": "0.7.1",
  "description": "WacPad official landing page, download portal, Stripe payment checkout, and cryptographic licensing system",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "pages:dev": "wrangler pages dev public --compatibility-flags=nodejs_compat",
    "deploy": "wrangler deploy",
    "start": "node server.js",
    "test": "node --test test/licensing.test.js test/api.test.js test/security.test.js test/activation.test.js test/recovery.test.js test/cloudflare-adapter.test.js test/d1.test.js test/razorpay.test.js test/dodo.test.js test/e2e-dual-checkout.test.js",
    "test:stripe": "node --test test/test-stripe-e2e.js",
    "test:hiwl": "node test/hiwl/run_interactive.js",
    "test:hiwl:razorpay": "node test/hiwl/run_interactive.js --rail razorpay",
    "test:hiwl:dodo": "node test/hiwl/run_interactive.js --rail dodo",
    "test:hiwl:playwright": "node test/hiwl/run_playwright.js",
    "test:hiwl:playwright:headed": "node test/hiwl/run_playwright.js --headed",
    "gen:keys": "node scripts/generate-keys.js"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.4",
    "dodopayments": "^2.55.0",
    "dotenv": "^16.4.5",
    "razorpay": "^2.9.8",
    "stripe": "^17.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
