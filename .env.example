# ==============================================================================
# WacPad Website & Payment System Configuration
# ==============================================================================

# Server Port (for local development)
PORT=3000

# Stripe Secret API Key (from https://dashboard.stripe.com/apikeys)
# Leave as placeholder or omit to test with built-in instant test mock mode!
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Webhook Signing Secret (from https://dashboard.stripe.com/webhooks)
# Used to verify incoming events from Stripe
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Cryptographic HMAC secret key
# MUST MATCH crates/wacpad-core/src/licensing.rs LICENSE_SECRET
WACPAD_LICENSE_SECRET=wacpad-license-key-v1-secret

# (Optional) Resend API Key for automated transactional emails
# Free tier gives 3,000 emails/month at https://resend.com
# If left unset, email delivery is simulated and logged to the console.
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=WacPad Pro <licensing@wacpad.com>

# Device Seat Limit & Hardware Activation (Upstash Redis)
# Free tier: 10,000 commands/day from https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Ed25519 private key for signing offline activation tokens (WPACT-)
# Generate with: npm run gen:keys
# KEEP THIS STRICTLY PRIVATE - NEVER expose to clients or commit to repository
ACTIVATION_TOKEN_PRIVATE_KEY=d2b426e25a5c69da785108714243fa911c42809034ee84e19f18e5eb5fac041d
